{
  "name": "isweb-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "cd client && vite --host 0.0.0.0",
    "dev:api": "node server/server.js",
    "dev:full": "concurrently \"npm run dev:api\" \"npm run dev\"",
    "build": "cd client && vite build",
    "lint": "cd client && eslint .",
    "preview": "cd client && vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@emailjs/browser": "4.4.1",
    "framer-motion": "11.11.17",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "mongoose": "8.9.5"
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "concurrently": "9.1.0",
    "eslint": "9.15.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-react-refresh": "0.4.14",
    "globals": "15.12.0",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "vite": "5.4.11"
  },
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": "20.x"
  }
}
