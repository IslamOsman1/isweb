MONGODB_URI=mongodb://127.0.0.1:27017/isweb_studio
PORT=5050
# يمكن إضافة عناوين متعددة من أجهزة مختلفة (مثل أو محرّف localhost في نفس الشبكة)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:*,http://127.0.0.1:*,http://*:5173
VITE_API_URL=/api

# Admin login password. Change both values to the same strong password.
ADMIN_PASSWORD=change_this_admin_password
VITE_ADMIN_PASSWORD=change_this_admin_password

# Cloudinary credentials for image upload
# Get these from your Cloudinary dashboard: https://cloudinary.com/console/settings/api-keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ====== VERCEL ENVIRONMENT VARIABLES ======
# على Vercel، استبدل MONGODB_URI بـ MongoDB Atlas connection string:
# MONGODB_URI=mongodb+srv://username:password@cluster.xxxxx.mongodb.net/isweb_studio?retryWrites=true&w=majority
# اتركه موضحًا أعلاه للـ development المحلي

